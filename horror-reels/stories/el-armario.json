  "scenes": [
    {
      "id": "s1",
      "set": "bedroom",
      "speaker": "narrador",
      "text": "Lucía tenía ocho años cuando empezó a oír golpes dentro de su armario.",
      "camera": "zoomIn",
      "kid": {
        "x": 760,
        "mood": "normal",
        "look": -1
      },
      "closet": 0,
      "showTitle": true,
      "pauseAfter": 0.3
    },
    {
      "id": "s2",
      "set": "bedroom",
      "speaker": "narrador",
      "text": "Toc. Toc. Toc. Siempre a las tres de la mañana.",
      "camera": "shake",
      "kid": {
        "x": 760,
        "mood": "scared",
        "look": -1
      },
      "closet": 0,
      "sfx": "knock",
      "clock": "3:00",
      "pauseAfter": 0.4
    },
    {
      "id": "s3",
      "set": "bedroom",
      "speaker": "lucia",
      "text": "¿Ma... mamá? ¿Eres... tú?",
      "camera": "closeKid",
      "kid": {
        "x": 760,
        "mood": "scared",
        "look": -1
      },
      "closet": 0,
      "pauseAfter": 0.8
    },
    {
      "id": "s4",
      "set": "hallway",
      "speaker": "narrador",
      "text": "Pero su madre dormía al otro lado de la casa, con la puerta cerrada con llave.",
      "camera": "dolly",
      "pauseAfter": 0.3
    },
    {
      "id": "s5",
      "set": "bedroom",
      "speaker": "narrador",
      "text": "Una noche, la puerta del armario se abrió sola. Solo un poco.",
      "camera": "panCloset",
      "kid": {
        "x": 760,
        "mood": "scared",
        "look": -1
      },
      "closet": 0.35,
      "ghost": {
        "where": "closet"
      },
      "sfx": "creak",
      "pauseAfter": 0.5
    },
    {
      "id": "s6",
      "set": "closet",
      "speaker": "fantasma",
      "text": "Lucía... déjame salir.",
      "camera": "zoomIn",
      "ghost": {
        "where": "closet"
      },
      "pauseAfter": 0.6
    },
    {
      "id": "s7",
      "set": "bedroom",
      "speaker": "narrador",
      "text": "Lucía no contestó. Se tapó con la manta y contó hasta cien.",
      "camera": "zoomIn",
      "kid": {
        "x": 760,
        "mood": "hiding",
        "look": 0
      },
      "closet": 0.35,
      "pauseAfter": 0.3
    },
    {
      "id": "s7b",
      "set": "bedroom",
      "speaker": "lucia",
      "text": "Noventa y ocho... noventa y nueve... cien.",
      "camera": "slowZoomIn",
      "kid": {
        "x": 760,
        "mood": "hiding",
        "look": 0
      },
      "closet": 0.35,
      "sfx": "heartbeat",
      "pauseAfter": 0.6
    },
    {
      "id": "s8",
      "set": "bedroom",
      "speaker": "narrador",
      "text": "Cuando llegó a cien, la voz ya no venía del armario.",
      "camera": "slowZoomIn",
      "kid": {
        "x": 760,
        "mood": "hiding",
        "look": 0
      },
      "closet": 1,
      "pauseAfter": 1.0,
      "sfx": "creak"
    },
    {
      "id": "s9",
      "set": "underbed",
      "speaker": "narrador",
      "text": "Venía de debajo de su cama.",
      "camera": "jumpscare",
      "ghost": {
        "where": "underbed"
      },
      "sfx": "sting",
      "pauseAfter": 0.8
    },
    {
      "id": "s10",
      "set": "black",
      "speaker": "narrador",
      "text": "Y tú... ¿ya revisaste debajo de la tuya?",
      "camera": "none",
      "pauseAfter": 1.5
    }
  ]
}